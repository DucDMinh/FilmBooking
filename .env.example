# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit secret.
# Nguồn: docs/specs/2026-11-10-filmbooking-mvp-design.md (Secrets), .context/project-config.md

# ─── apps/web (Next.js, Vercel) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
# URL Nest dùng phía SERVER của Next (proxy /api/proxy, Server Components); không có NEXT_PUBLIC_. Bỏ trống = dùng NEXT_PUBLIC_API_URL
API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ─── apps/api (NestJS, Render) ───
PORT=
WEB_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
JOB_SECRET=
SENTRY_DSN=

# ─── DB staging/prod (tên env var khai trong project-config; chỉ dùng cho CI/deploy) ───
SUPABASE_DB_URL_STAGING=
SUPABASE_DB_URL_PROD=
