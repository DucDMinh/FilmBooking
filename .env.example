# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit secret.
# Nguồn: docs/specs/2026-11-10-filmbooking-mvp-design.md (Secrets), .context/project-config.md

# ─── apps/web (Next.js, Vercel) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
# URL Nest dùng phía SERVER của Next (proxy /api/proxy, Server Components); không có NEXT_PUBLIC_. Bỏ trống = dùng NEXT_PUBLIC_API_URL
API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# URL công khai của site (canonical/sitemap/OG); production bắt buộc đặt
NEXT_PUBLIC_SITE_URL=

# ─── apps/api (NestJS, Render) ───
PORT=
WEB_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Xác thực JWT bất đối xứng qua JWKS: URL JWKS + issuer của dự án Supabase
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
# Số proxy tin cậy phía trước API (Render = 1) để lấy đúng IP client
TRUST_PROXY_HOPS=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# SMTP gửi mail outbox (/jobs/send-emails). Bỏ trống SMTP_HOST = không gửi (test mock, môi trường khác báo lỗi).
# Gmail: smtp.gmail.com / 465 / user = địa chỉ Gmail / pass = App Password (bật 2FA). Gmail ghi đè from thành chính tài khoản.
# Resend: smtp.resend.com / 465 / user = resend / pass = API key. SMTP_PORT 465 = TLS ngay, cổng khác (vd 587) = STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Người gửi, vd "CINEMO <no-reply@domain-da-xac-minh>"; trống = "FilmBooking <SMTP_USER>"
SMTP_FROM=
TURNSTILE_SECRET_KEY=
JOB_SECRET=
SENTRY_DSN=

# ─── DB staging/prod (tên env var khai trong project-config; chỉ dùng cho CI/deploy) ───
SUPABASE_DB_URL_STAGING=
SUPABASE_DB_URL_PROD=
