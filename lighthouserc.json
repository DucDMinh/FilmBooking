{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/phim",
        "http://127.0.0.1:3200/rap"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ]
      }
    }
  }
}
